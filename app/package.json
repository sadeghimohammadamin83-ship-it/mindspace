{
  "name": "mindspace",
  "productName": "MINDSPACE",
  "version": "0.1.0",
  "description": "MINDSPACE: a private, local-first second brain for Windows (Phase 2: local SQLite storage)",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:win": "npm run build && electron-builder --win --x64 --config electron-builder.yml",
    "build:win:linux": "npm run build && electron-builder --win --x64 --config electron-builder.yml -c.win.signAndEditExecutable=false",
    "release:win": "npm run build:win && node scripts/release-manifest.cjs",
    "pack:dir": "npm run build && electron-builder --dir --config electron-builder.yml"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "liquid-gooey": "^0.2.2",
    "lucide-react": "^1.55.0",
    "motion": "^12.43.0",
    "radix-ui": "^1.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@huggingface/tokenizers": "0.2.0",
    "better-sqlite3": "^13.0.3",
    "onnxruntime-node": "1.30.0",
    "openai": "^7.32.0",
    "pdfjs-dist": "^6.4.299",
    "zod": "^4.6.7"
  },
  "author": "MINDSPACE",
  "homepage": "https://claude.ai/code/project/chan_01DaLh4FRSezoWhHMXt9ujsE"
}
